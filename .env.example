# Optional. Without a key, Warden uses the offline (deliberately gullible) agent.
ANTHROPIC_API_KEY=
WARDEN_MODEL=claude-opus-5-5
# Set to "offline" to force the gullible agent even when a key is set (good for rehearsing the attack).
WARDEN_AGENT=

XRPL_NETWORK=wss://s.altnet.rippletest.net:51233
XRPL_EXPLORER=https://testnet.xrpl.org
PORT=3000
